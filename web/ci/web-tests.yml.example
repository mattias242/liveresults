# Web tier CI for LiveResults.
#
# The automation account used to open the current PR cannot push files under
# .github/workflows/ (it lacks the GitHub "workflows" permission). Copy this
# file to .github/workflows/web-tests.yml from an account that has it, and
# PHPUnit will run on every change under web/.

name: web-tests

on:
  push:
    branches: [master, "claude/**"]
    paths: ["web/**", ".github/workflows/web-tests.yml"]
  pull_request:
    paths: ["web/**", ".github/workflows/web-tests.yml"]

jobs:
  phpunit:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: web
    steps:
      - uses: actions/checkout@v4

      - name: Set up PHP
        uses: shivammathur/setup-php@v2
        with:
          php-version: "8.3"
          tools: composer
          coverage: none

      - name: Install dependencies
        run: composer install --no-interaction --no-progress --prefer-dist

      - name: Run PHPUnit
        run: vendor/bin/phpunit

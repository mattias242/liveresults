{
  "name": "liveresults-spa",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Modern SPA frontend for LiveResults, built against the existing /api/v1 JSON API",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
